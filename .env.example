# Example configuration for S3-compatible storage.
S3_BUCKET=my-bucket
S3_REGION=us-east-1

# AWS S3: leave S3_ENDPOINT empty.
# MinIO / R2 / Spaces / Yandex: set the endpoint and (for MinIO) force path style.
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
